export class TaskGraph {
  /**
   * @param {{ layout: import('./paths.js').Layout, policy: import('./policy.js').PolicyEngine, audit: import('./audit.js').AuditLog, clock: import('./kernel/time.js').Clock, memory?: import('./memory.js').MemoryService, registry?: import('./registry.js').RoleRegistry }} spec
   *   `memory` 鍙 `settle`锛堢粨璐﹀綊妗ｄ綔绛旓級鐢紱`registry` 鍙娲惧彂闂革紙`#assertOwnersSeated`锛夌敤銆?
   *   涓よ€呴兘鐢辫閰嶇偣锛坥rg.js锛夎礋璐ｆ帴涓婏紱**鐩存帴鏋勯€犱笉鎺ュ畠浠?= 澶瑰叿鍙ｅ緞**锛堝搴旀満鍒惰嚜鍔ㄩ€€浣嶏紝
   *   涓嶆槸鏃佽矾鈥斺€旇閰嶉潰 org.js 鎭掓敞鍏ワ紝瑙?test/dispatch-liveness.test.js 鐨勫す鍏峰彛寰勭敤渚嬶級銆?
   */
  constructor(spec) {
    this.layout = spec.layout;
    this.policy = spec.policy;
    this.audit = spec.audit;
    this.clock = spec.clock;
    this.memory = spec.memory ?? null;
    this.registry = spec.registry ?? null;
    /**
     * 浜嬩欢娴佽缂撳瓨锛?026-10-13 绗笁鎵规€ц兘鏀跺彛锛夛細閿?= 璐︽湰璺緞锛屽€?= {绛惧悕, rows}銆?
     * 涓轰粈涔堝畨鍏細**鐪熸簮浠嶆槸鏂囦欢**锛岀鍚嶏紙mtimeMs+size+鏈繘绋嬪啓璁℃暟锛変竴鍙樺嵆閲嶈銆?
     * 淇墠姣忎釜鍏紑鎿嶄綔閮借閲嶈+閲嶈В鏋愭暣鏉′簨浠舵祦锛坓et/list/#append/鍐欏悗鍐嶈锛夛紝
     * 涓€娆?submit 鏈€澶?4 閬嶅叏閲忥紱璐︽湰涓婁竾琛屾椂鍐欒矾寰勬槑鏄惧姡鍖栥€?
     */
    this.#readCache = new Map();
    /** 鏈繘绋嬪啓璁℃暟锛堝啓鍚庡嵆浣?mtime/size 鎾炶溅涔熼噸璇烩€斺€斿悓涓€涓啓鑰呰嚜宸辩煡閬撹嚜宸卞啓杩囷級銆?*/
    this.#writeCount = new Map();
  }

  /** @type {Map<string, {绛惧悕: string, rows: object[]}>} */
  #readCache;
  /** @type {Map<string, number>} */
  #writeCount;

  /**
   * 浜嬩欢琛岋紙甯﹁缂撳瓨锛夛細绛惧悕 = 鐩樹笂 mtime+size + 鏈繘绋嬪杩欐潯璐︽湰鐨勫啓娆℃暟銆?
   * @param {string} 椤圭洰
   * @returns {Promise<object[]>}
   */
  async #rowsOf(椤圭洰) {
    const file = this.layout.taskLog(椤圭洰);
    let 绛惧悕;
    try {
      const st = await stat(file);
      绛惧悕 = `${st.mtimeMs}:${st.size}:${this.#writeCount.get(file) ?? 0}`;
    } catch {
      绛惧悕 = `absent:${this.#writeCount.get(file) ?? 0}`;
    }
    const hit = this.#readCache.get(file);
    if (hit?.绛惧悕 === 绛惧悕) return hit.rows;
    const rows = await readJsonl(file);
    this.#readCache.set(file, { 绛惧悕, rows });
    return rows;
  }

  /** 璁颁竴娆℃湰杩涚▼鍐欏叆锛氳缂撳瓨绛惧悕澶辨晥锛堜笅涓€娆¤蹇呯劧閲嶈锛夈€?*/
  #bumpWrite(椤圭洰) {
    const file = this.layout.taskLog(椤圭洰);
    this.#writeCount.set(file, (this.#writeCount.get(file) ?? 0) + 1);
  }

  /**
   * 寤鸿妭鐐广€傚垽鎹槸蹇呭～椤癸紝涓嶆槸鍙€夎鏄庛€?
   *
   * 渚濊禆鏍￠獙锛圵3 鎵?路2026-10-09锛夊湪**閿佸唴**鍋氾紙瑙?`#assertDependencies`锛夛細
   * 渚濊禆鎸囧悜绌烘皵浼氳娲惧彂姘歌繙绛変笉鍒板墠缃紱渚濊禆閾炬垚鐜細璁┿€屽厛鍋氳皝銆嶈繖浠朵簨娌℃湁瑙ｃ€?
   *
   * @param {{ subject: object, 鎻忚堪: string, 璐熻矗浜? string|string[], 鍒ゆ嵁: string|string[], 渚濊禆?: string[], 椤圭洰: string }} input
   * @returns {Promise<object>} 鑺傜偣鎶曞奖
   */
  async create(input) {
    if (!input.鎻忚堪?.trim()) throw new InvalidBody('浠诲姟鑺傜偣蹇呴』鏈夋弿杩般€?);
    const 鍒ゆ嵁 = normalizeList(input.鍒ゆ嵁);
    if (鍒ゆ嵁.length === 0) throw new InvalidBody('楠屾敹鏍囧噯蹇呭～锛氭病鏈夊垽鎹殑鑺傜偣鏃犳硶楠屾敹锛屼篃鏃犳硶鍦ㄦ淳鍙戝悗鍐荤粨銆?, { missing: ['鍒ゆ嵁'] });
    // 鍘婚噸锛?026-10-12 璇勫 P3锛夛細['A','A'] 浼氳浼氬杩涘害/鍙備笌鑰呮暟铏氬锛?
    // 銆屼氦榻愩€嶅垽鎹櫧鎸変汉鍘婚噸鍒ゅ畾涓嶅彈褰卞搷锛屼絾璇绘暟璇磋皫灏辨槸缂洪櫡銆?
    const 璐熻矗浜?= [...new Set(normalizeList(input.璐熻矗浜?)];
