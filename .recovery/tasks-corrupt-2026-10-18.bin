        node.寰呭喅鍘熷洜 = row.寰呭喅鍘熷洜;
        node.寰呭喅绫诲瀷 = row.寰呭喅绫诲瀷;
        break;
      case 'resolved':
        // 缂虹姸鎬佺殑鏃ф暟鎹厹搴曞彇銆屽緟鍐冲墠鐨勭姸鎬併€嶏紙2026-10-14 瀹℃煡 P3锛夛細淇墠鎭掑厹銆屽凡浜ゅ嵎銆嶏紝
        // 鎵ц涓寕鐨勫緟鍐宠閿欒鎭㈠鎴愬凡浜ゅ嵎銆俻ending/review_nominated 浜嬩欢閮戒細璁?
        // 寰呭喅鍓嶇殑鐘舵€侊紱杩炲畠涔熸病鏈夛紙鏇磋€佺殑璐︼級鎵嶉€€鍥炲凡浜ゅ嵎銆?
        node.鐘舵€?= row.鐘舵€??? node.寰呭喅鍓嶇殑鐘舵€??? '宸蹭氦鍗?;
        node.寰呭喅 = false;
        node.宸插喅 = { 鍐冲畾: row.鍐冲畾, 浜? row.宸插喅浜?};
        node.寰呭喅璁板綍 = [...(node.寰呭喅璁板綍 ?? []), { 鍘熷洜: node.寰呭喅鍘熷洜, 鍐冲畾: row.鍐冲畾, 浜? row.宸插喅浜?}];
        break;
      case 'artifact':
        node.浜у嚭鐗╁紩鐢?= [...new Set([...(node.浜у嚭鐗╁紩鐢??? []), row.浜у嚭鐗)];
        break;
      case 'escalated':
        node.鍗囩骇 = row.鍗囩骇;
        break;
      // 缁撹处锛圵3 鎵?锛夛細鐜矾鐨勭粓鎬併€傚綊妗ｆ潯鏁颁竴璧锋姌杩涜妭鐐光€斺€斻€岀粨璐︽椂褰掓。浜嗗嚑鏉′綔绛斻€?
      // 鏄繖鏉＄粓鎬佺殑璇绘暟锛岃闈㈡澘鐨勪汉涓嶇敤鍐嶅幓缈昏蹇嗚处鏈€?
      case 'settled':
        node.鐘舵€?= row.鐘舵€??? '宸茬粨璐?;
        node.缁撹处浜?= row.at;
        node.褰掓。鏉℃暟 = row.褰掓。鏉℃暟 ?? 0;
        // v2 鏉＄洰16锛氳蹇嗗缃０鏄庨殢缁撹处浜嬩欢鎶樺洖鑺傜偣鈥斺€旇闈㈠彲瑙併€岀粨璐︽椂閫愭潯鍒や簡浠€涔堛€嶃€?
        if (row.璁板繂澶勭疆) node.璁板繂澶勭疆 = row.璁板繂澶勭疆;
        break;
      // 鈹€鈹€ W2 浼氬璁ㄨ娈碉紙2026-10-09锛夛細璁ㄨ鏄妭鐐圭殑**瀛愮姸鎬?*锛屼笉鍔ㄨ妭鐐逛富鐘舵€?
      //    锛堝凡浜ゅ嵎淇濇寔鈥斺€旇璁轰腑浠嶅彲 review锛岃蒋绾︽潫涓嶈鍙樻垚姝婚攣锛夈€?
      case 'debate_opened':
        node.璁ㄨ = {
          鐘舵€? '璁ㄨ涓?,
          杞: 1,
          杞涓婇檺: row.杞涓婇檺,
          鍙備笌鑰? row.鍙備笌鑰??? [],
          // 鈶?寮哄埗鍙嶅鑰咃紙2026-10-10锛夛細绌轰覆 = 褰撴椂娌℃湁鍙敤鍊欓€夛紙瀹佺己姣嬫互锛夛紝
          // 涓庛€屾牴鏈病鎸囧畾杩囥€嶅湪鏃ф暟鎹笂鍚屽舰鈥斺€旀棫浜嬩欢娌℃湁杩欎袱涓敭 鈬?鍏滃簳鎴?''銆?
          鍙嶅鑰? row.鍙嶅鑰??? '',
          鍙嶅鑰呬緷鎹? row.鍙嶅鑰呬緷鎹??? '',
          // 棰勭畻蹇収鍦ㄥ紑鍚椂鍐荤粨锛堝垽鎹喕缁撳悓鍝插锛夛細涔嬪悗鏀归儴缃?json 涓嶅奖鍝嶈繘琛屼腑鐨勮璁恒€?
          棰勭畻蹇収: row.棰勭畻蹇収 ?? {},
          寮€浜? row.at,
        };
        break;
      case 'debate_round':
        if (node.璁ㄨ) node.璁ㄨ = { ...node.璁ㄨ, 杞: row.杞 };
        break;
      case 'debate_converged':
        if (node.璁ㄨ) node.璁ㄨ = { ...node.璁ㄨ, 鐘舵€? '宸叉敹鏁?, 琛ㄦ€佹秷鎭痠d: row.琛ㄦ€佹秷鎭痠d ?? null, 鏀舵暃浜? row.at };
        break;
      default:
        break;
    }
    node.鏈€杩戜簨浠朵簬 = row.at;
  }
  return nodes;
}

/** @param {string|string[]|undefined} value */
function normalizeList(value) {
  if (value === undefined || value === null) return [];
  return (Array.isArray(value) ? value : [value]).map((v) => String(v).trim()).filter(Boolean);
}

/** @param {string} text @param {string} fallback */
function slugOf(text, fallback) {
  // 16 瀛楋細澶熻鍑烘槸鍝釜鑺傜偣锛屽張涓嶈嚦浜庤 id 鍙樻垚涓€鏁村彞璇濄€?
  const folded = String(text).normalize('NFKC').replace(/[^\p{Letter}\p{Number}]+/gu, '-').replace(/^-|-$/g, '').slice(0, 16);
  return folded || fallback;
}
