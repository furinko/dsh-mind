  // 涓庝慨鍓嶉€愬瓧鍚屽彛寰勩€?
  const 鍚嶅崟 = (node?.缁戝畾 ?? []).length > 0 ? node.缁戝畾.map((b) => b.瀹炰緥) : (node?.璐熻矗浜??? []);
