{
  "name": "dsh-mind",
  "version": "1.9.0",
  "type": "module",
  "description": "心智 · 数字组织 —— 一张插件卡，三个组件：内核 / 安全类 / 看板",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "digital-organization",
    "governance",
    "policy-engine",
    "audit"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./kernel": "./components/kernel/lib/index.js",
    "./guard": "./components/guard/lib/index.js",
    "./client": "./components/board/lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./icon.svg": "./icon.svg"
  },
  "meta": {
    "title": "心智 · 数字组织",
    "description": "数字组织的治理内核：策略引擎 · 任务图 · 消息总线 · 能力库 · 记忆服务 · 审计日志 · 角色注册表 · 共享工作台"
  },
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": true
    }
  },
  "files": [
    "lib",
    "src",
    "mind",
    "scripts",
    "components/kernel/lib",
    "components/guard/lib",
    "components/board/lib",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "dsh:check": "bash scripts/local-dsh.sh check",
    "dsh:status": "bash scripts/local-dsh.sh status",
    "dsh:deploy": "bash scripts/local-dsh.sh deploy",
    "dsh:rollback": "bash scripts/local-dsh.sh rollback",
    "test": "node test/preflight.mjs && node --test \"test/*.test.js\" \"components/board/test/*.test.js\" && node components/board/test/client-harness.mjs",
    "preflight": "node test/preflight.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.5-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  }
}
