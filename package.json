{
  "name": "dsh-mind",
  "version": "0.1.3",
  "description": "可移植的心智内核：每会话注入宪法（SOUL + AGENTS）、上工自动召回记忆、写前护栏与自我修改门禁、技能触发加载，并在首次启动时从包内固件自举。",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./paths": "./lib/paths.js",
    "./bootstrap": "./lib/bootstrap.js",
    "./host-resolve": "./lib/host-resolve.js",
    "./message-source": "./lib/message-source.js",
    "./search": "./lib/search.js",
    "./host/inject": "./lib/host/inject.js",
    "./host/recall": "./lib/host/recall.js",
    "./host/connect": "./lib/host/connect.js",
    "./host/guard": "./lib/host/guard.js",
    "./host/skill-loader": "./lib/host/skill-loader.js",
    "./host/compaction-log": "./lib/host/compaction-log.js",
    "./host/mood": "./lib/host/mood.js",
    "./host/session-budget": "./lib/host/session-budget.js",
    "./host/agent-roles": "./lib/host/agent-roles.js",
    "./host/api": "./lib/host/api.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./host/inject/locale/en.json": "./locale/parts/inject/en.json",
    "./host/inject/locale/zh.json": "./locale/parts/inject/zh.json",
    "./host/recall/locale/en.json": "./locale/parts/recall/en.json",
    "./host/recall/locale/zh.json": "./locale/parts/recall/zh.json",
    "./host/connect/locale/en.json": "./locale/parts/connect/en.json",
    "./host/connect/locale/zh.json": "./locale/parts/connect/zh.json",
    "./host/guard/locale/en.json": "./locale/parts/guard/en.json",
    "./host/guard/locale/zh.json": "./locale/parts/guard/zh.json",
    "./host/skill-loader/locale/en.json": "./locale/parts/skill-loader/en.json",
    "./host/skill-loader/locale/zh.json": "./locale/parts/skill-loader/zh.json",
    "./host/compaction-log/locale/en.json": "./locale/parts/compaction-log/en.json",
    "./host/compaction-log/locale/zh.json": "./locale/parts/compaction-log/zh.json",
    "./host/mood/locale/en.json": "./locale/parts/mood/en.json",
    "./host/mood/locale/zh.json": "./locale/parts/mood/zh.json",
    "./host/session-budget/locale/en.json": "./locale/parts/session-budget/en.json",
    "./host/session-budget/locale/zh.json": "./locale/parts/session-budget/zh.json",
    "./host/agent-roles/locale/en.json": "./locale/parts/agent-roles/en.json",
    "./host/agent-roles/locale/zh.json": "./locale/parts/agent-roles/zh.json",
    "./host/api/locale/en.json": "./locale/parts/api/en.json",
    "./host/api/locale/zh.json": "./locale/parts/api/zh.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "files": [
    "lib/",
    "client/",
    "firmware/",
    "locale/",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "selftest": "node test/selftest.mjs",
    "contract": "node test/pre-step-waterfall.mjs",
    "test": "node test/selftest.mjs && node test/pre-step-waterfall.mjs",
    "verify-install": "node scripts/verify-dsh-mind-install.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <5",
    "@deepseek-ai/dsh": ">=0.1.5-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  }
}
